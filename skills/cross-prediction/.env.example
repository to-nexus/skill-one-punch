# cross-prediction skill environment variables
#
# Copy to .env in THIS folder, or in your project's working directory.
# The skill resolves in this order: CWD/.env → ~/.claude/skills/cross-prediction/.env → prompt.
#
# Permissions: chmod 600 .env

# REQUIRED — the embedded wallet address of your social-login account on prediction.crossdefi.io
WALLET_ADDRESS=0x...

# OPTIONAL — pick the trading strategy. Leave unset for "auto" (A → C by precedence).
#   A: local viem signer (requires PRIVATE_KEY).      Fastest, full control.
#   C: CROSSx gateway remote signer (requires PIN + configured gateway). Server signs via PIN.
# STRATEGY=A

# Strategy A — only set via local signer config for a disposable wallet.
# PRIVATE_KEY is read from this local file or process env only; never paste it into chat or argv.

# Strategy C — your 6-digit CROSSx service PIN.
# PIN=123456

# Strategy C only — gateway auth token supplied through a secure local channel.
# Do not paste browser-derived auth material into chat.
# CROSSX_AUTH_TOKEN=...
# CROSSX_GATEWAY_BASE=https://embedded-wallet-gateway.crosstoken.io/api/v1

# OPTIONAL — trade cap. Rejects any single buy/sell whose notional BILL exceeds this.
MAX_TRADE_BILL=100

# OPTIONAL — endpoint overrides
# CROSS_RPC_URL=https://mainnet.crosstoken.io:22001/
# PREDICTION_API_BASE=https://pred-bill-service-api.crossdefi.io/api/v1
# CROSS_AUTH_BASE=https://cross-auth.crosstoken.io/cross-auth
