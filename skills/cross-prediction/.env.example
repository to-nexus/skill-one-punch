# cross-prediction skill environment variables
#
# Copy to .env in THIS folder, or in your project's working directory.
# The skill resolves in this order: CWD/.env → ~/.claude/skills/cross-prediction/.env → prompt.
#
# Permissions: chmod 600 .env

# REQUIRED — the embedded wallet address of your social-login account on prediction.crossdefi.io
WALLET_ADDRESS=0x...

# OPTIONAL — pick the trading strategy. Leave unset for "auto" (A → B → C by precedence).
#   A: local viem signer (requires PRIVATE_KEY).      Fastest, full control.
#   B: Playwright UI automation (requires PIN + saved session).  PK never leaves CROSSx.
#   C: CROSSx gateway remote signer (requires PIN + recon).      Server signs via PIN.
# STRATEGY=A

# Strategy A — only set if you exported the embedded wallet's private key.
# PRIVATE_KEY=0x...

# Strategy B / C — your 6-digit CROSSx service PIN.
# PIN=123456

# Strategy C only — captured social-login bearer token. The recon tool writes
# this into .session/gateway.json automatically; set it here only to override.
# CROSSX_AUTH_TOKEN=...
# CROSSX_GATEWAY_BASE=https://embedded-wallet-gateway.crosstoken.io/api/v1

# OPTIONAL — trade cap. Rejects any single buy/sell whose notional BILL exceeds this.
MAX_TRADE_BILL=100

# OPTIONAL — endpoint overrides
# CROSS_RPC_URL=https://mainnet.crosstoken.io:22001/
# PREDICTION_BASE_URL=https://prediction.crossdefi.io
# CROSS_AUTH_BASE=https://cross-auth.crosstoken.io/cross-auth

# OPTIONAL — Playwright debug. Set PW_HEADFUL=1 to watch Strategy B drive the UI.
# PW_HEADFUL=1
